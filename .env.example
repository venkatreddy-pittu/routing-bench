# Local model (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Cloud model (AWS Bedrock) - use your own credentials via the AWS CLI/profile, never commit keys
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=<paste the exact model id you are benchmarking>

# USD per 1M tokens for that model - copy from the AWS pricing page and note the date in your README
BEDROCK_IN_PER_1M=
BEDROCK_OUT_PER_1M=
